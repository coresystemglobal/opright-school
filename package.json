{
  "name": "school-saas",
  "version": "1.0.0",
  "description": "Multi-tenant school management SaaS",
  "main": "dist/server.js",
  "scripts": {
    "load:basic": "node tests/load/basic-load.js",
    "load:stress": "node tests/load/stress-test.js",
    "load:spike": "node tests/load/spike-test.js",
    "k6:load": "k6 run tests/load/k6-load-test.js",
    "k6:stress": "k6 run tests/load/k6-stress-test.js",
    "k6:spike": "k6 run tests/load/k6-spike-test.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "docs:generate": "node --import tsx scripts/generate-api-docs.ts",
    "start": "tsc && node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "cypress run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:setup": "npm run db:push && npm run db:generate",
    "seed:tier1": "tsx src/utils/seedTier1.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.906.0",
    "@aws-sdk/s3-request-presigner": "^3.906.0",
    "@prisma/client": "^5.7.1",
    "@upstash/qstash": "^2.9.0",
    "@upstash/redis": "^1.36.3",
    "aws-sdk": "^2.1519.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "prisma": "^5.7.1",
    "redis": "^4.6.12",
    "ts-node-dev": "^2.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "autocannon": "^8.0.0",
    "cypress": "^13.6.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
