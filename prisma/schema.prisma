datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// ─────────────────────────────────────────
/// TENANCY & USERS
/// ─────────────────────────────────────────

model Tenant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  domain     String?  // custom domain (school.com)
  subdomain  String?  // subdomain (greenwood)
  schoolCode String?  // short uppercase code for student IDs (e.g. "GWD")
  config     Json?    // theme, settings
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscription Subscription?
  users      User[]
  roles      Role[]
  students   Student[]
  teachers   Teacher[]
  classes    Class[]
  enrollments Enrollment[]
  attendances Attendance[]
  fees       Fee[]
  payments   Payment[]
  academicYears AcademicYear[]
  terms      Term[]
  subjects   Subject[]
  grades     Grade[]
  timetables Timetable[]
  assignments Assignment[]
  examinations Examination[]
  examResults ExamResult[]
  books Book[]
  bookTransactions BookTransaction[]
  ebooks EBook[]
  readingProgress ReadingProgress[]
  buses Bus[]
  busRoutes BusRoute[]
  busAssignments BusAssignment[]
  assets Asset[]
  assetTransactions AssetTransaction[]
  events Event[]
  notices Notice[]
  eventParticipants EventParticipant[]
  disciplinaryRecords DisciplinaryRecord[]
  healthRecords HealthRecord[]
  medicalIncidents MedicalIncident[]
  vaccinations Vaccination[]
  hostelRooms HostelRoom[]
  hostelAssignments HostelAssignment[]
  mealPlans MealPlan[]
  visitorLogs VisitorLog[]
  activities Activity[]
  activityEnrollments ActivityEnrollment[]
  competitions Competition[]
  courses Course[]
  courseEnrollments CourseEnrollment[]
  lessons Lesson[]
  quizzes Quiz[]
  submissions Submission[]
  liveClasses LiveClass[]
  discussions Discussion[]
  certificates Certificate[]
  idSequences  IdSequence[]
  parents      Parent[]
  candidates   Candidate[]
  website      SchoolWebsite?

  @@unique([domain])
  @@unique([subdomain])
  @@unique([schoolCode])
}

model SchoolWebsite {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @unique @db.Uuid
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customDomain         String?  @unique
  customDomainVerified Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([customDomain])
}

model User {
  id          String   @id @default(uuid())
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email       String?  @unique  // null for students (they login with studentCode)
  studentCode String?           // e.g. "GWD250042" — set for student accounts
  password    String
  roleId      String?  @db.Uuid
  role        Role?    @relation(fields: [roleId], references: [id])
  firstName   String?
  lastName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student?  // back-relation
  parent      Parent?   // back-relation
  teacher     Teacher?  // back-relation
  noticesAuthored Notice[]

  @@index([tenantId])
  @@index([studentCode])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  
  resource    String   // e.g., "students", "teachers", "classes"
  action      String   // e.g., "create", "read", "update", "delete"
  description String?
  
  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
}

enum UserRole {
  ADMIN       // overall school admin
  PRINCIPAL   // head of school
  TEACHER
  PARENT
  STUDENT
  STAFF
}

/// ─────────────────────────────────────────
/// ID SEQUENCES
/// ─────────────────────────────────────────

enum IdSequenceType {
  STUDENT
  CANDIDATE
}

model IdSequence {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      IdSequenceType
  year      Int
  lastSeq   Int            @default(0)

  @@unique([tenantId, type, year])
  @@index([tenantId])
}

/// ─────────────────────────────────────────
/// PARENTS
/// ─────────────────────────────────────────

model Parent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String   @unique  // FK to User (parent's login account)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String?
  email     String?

  students  StudentParent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model StudentParent {
  studentId String  @db.Uuid
  parentId  String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

/// ─────────────────────────────────────────
/// CANDIDATES (applicants)
/// ─────────────────────────────────────────

enum CandidateStatus {
  PENDING
  ADMITTED
  REJECTED
}

model Candidate {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  candidateCode   String          // e.g. "GWDC250001"
  firstName       String
  lastName        String
  dob             DateTime?
  applicationData Json?           // flexible application fields
  status          CandidateStatus @default(PENDING)
  admittedAt      DateTime?
  studentId       String?         @db.Uuid  // set when admitted

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([tenantId, candidateCode])
  @@index([tenantId])
}

/// ─────────────────────────────────────────
/// STUDENTS & TEACHERS
/// ─────────────────────────────────────────

model Student {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentCode String?  // e.g. "GWD250042" — unique per tenant
  userId      String?  @unique  // FK to User (login account)
  user        User?    @relation(fields: [userId], references: [id])

  firstName   String
  lastName    String
  dob         DateTime?
  guardian    Json?    // legacy guardian JSON — kept for migration compatibility
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  attendances Attendance[]
  payments    Payment[]
  grades      Grade[]
  examResults ExamResult[]
  parents     StudentParent[]

  @@unique([tenantId, studentCode])
  @@index([tenantId])
  @@index([tenantId, lastName], map: "idx_student_tenant_name")
}

model Teacher {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String?  @unique  // FK to User (login account)
  user      User?    @relation(fields: [userId], references: [id])

  firstName        String
  lastName         String
  subject          String?   // free-text specialty (legacy)
  employeeId       String?
  email            String?
  phone            String?
  gender           String?
  dob              DateTime?
  address          String?
  qualification    String?
  bio              String?
  photoUrl         String?
  employmentDate   DateTime?
  employmentStatus String?   // e.g. "FULL_TIME", "PART_TIME", "CONTRACT"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes    Class[]
  subjects   Subject[]
  timetables Timetable[]
  courses    Course[]

  @@index([tenantId])
}

/// ─────────────────────────────────────────
/// CLASSES, ENROLLMENTS & ATTENDANCE
/// ─────────────────────────────────────────

model Class {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String   // e.g. "Grade 5"
  level     String?  // e.g. "Primary"
  teacherId String?  @db.Uuid  // homeroom teacher
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  subjects    Subject[]
  timetables  Timetable[]

  @@index([tenantId])
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId  String  @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId  String  @db.Uuid
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, classId]) // prevent duplicate enrollment
  @@index([tenantId])
}

model Attendance {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId  String  @db.Uuid
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date       DateTime
  status     AttendanceStatus
  remarks    String?

  createdAt  DateTime @default(now())

  @@unique([studentId, date]) // 1 record per student per day
  @@index([tenantId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// ─────────────────────────────────────────
/// FEES & PAYMENTS
/// ─────────────────────────────────────────

model Fee {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String    // "Tuition Fee - Term 1"
  amount    Float
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]

  @@index([tenantId, dueDate])
}

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feeId  String  @db.Uuid
  fee       Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)

  studentId  String  @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  amount    Float
  method    String   // Paystack/Flutterwave
  status    PaymentStatus
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// ─────────────────────────────────────────
/// ACADEMIC YEAR & TERMS
/// ─────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String   // "2024/2025"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms     Term[]
  subjects  Subject[]
  timetables Timetable[]
  assignments Assignment[]
  examinations Examination[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
}

model Term {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name           String       // "Term 1", "Semester 1"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments    Assignment[]
  examinations   Examination[]

  @@unique([academicYearId, name])
  @@index([tenantId, isCurrent])
}

/// ─────────────────────────────────────────
/// SUBJECTS
/// ─────────────────────────────────────────

model Subject {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name           String       // "Mathematics", "English"
  code           String?      // "MATH101"
  description    String?
  classId        String       @db.Uuid
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId      String?      @db.Uuid
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  timetables     Timetable[]
  assignments    Assignment[]
  examinations   Examination[]
  grades         Grade[]
  courses        Course[]

  @@unique([tenantId, academicYearId, classId, code])
  @@index([tenantId, classId])
}

/// ─────────────────────────────────────────
/// TIMETABLE/SCHEDULE
/// ─────────────────────────────────────────

model Timetable {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  subjectId      String       @db.Uuid
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId        String       @db.Uuid
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId      String       @db.Uuid
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek      Int          // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime      String       // "09:00"
  endTime        String       // "10:00"
  room           String?      // "Room 101"
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId, classId, dayOfWeek])
  @@index([tenantId, teacherId, dayOfWeek])
}

/// ─────────────────────────────────────────
/// GRADEBOOK - ASSIGNMENTS & GRADES
/// ─────────────────────────────────────────

model Assignment {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String       @db.Uuid
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjectId      String       @db.Uuid
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  maxScore       Float
  weight         Float        @default(1.0) // weight in final grade calculation
  dueDate        DateTime?
  assignedDate   DateTime     @default(now())
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  grades         Grade[]

  @@index([tenantId, subjectId])
}

model Grade {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  studentId    String     @db.Uuid
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String     @db.Uuid
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignmentId String?    @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  score        Float
  maxScore     Float
  remarks      String?
  gradedAt     DateTime   @default(now())
  gradedBy     String?    // teacher ID
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, assignmentId])
  @@index([tenantId, studentId, subjectId])
}

/// ─────────────────────────────────────────
/// EXAMINATIONS
/// ─────────────────────────────────────────

model Examination {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String       @db.Uuid
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjectId      String       @db.Uuid
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  name           String       // "Mid-term Exam", "Final Exam"
  examDate       DateTime
  duration       Int?         // minutes
  maxScore       Float
  passingScore   Float?
  room           String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  results        ExamResult[]

  @@index([tenantId, subjectId, examDate])
}

model ExamResult {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  examinationId String      @db.Uuid
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  studentId     String      @db.Uuid
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score         Float
  grade         String?     // "A", "B", "C", etc.
  remarks       String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examinationId, studentId])
  @@index([tenantId, studentId])
}

/// ─────────────────────────────────────────
/// LIBRARY MANAGEMENT
/// ─────────────────────────────────────────

model Book {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  author      String
  isbn        String?
  genre       String?
  totalCopies Int      @default(1)
  available   Int      @default(1)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions BookTransaction[]
  ebooks        EBook[]

  @@index([tenantId, isbn])
  @@index([tenantId, available], map: "idx_book_tenant_available")
}

model BookTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  bookId      String    @db.Uuid
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrowerId  String    @db.Uuid
  borrowerType String   // "STUDENT" or "STAFF"
  
  borrowDate  DateTime  @default(now())
  dueDate     DateTime
  returnDate  DateTime?
  fine        Float     @default(0)
  status      BookStatus @default(BORROWED)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, borrowerId])
  @@index([tenantId, status])
}

enum BookStatus {
  BORROWED
  RETURNED
  LOST
  OVERDUE
}

/// ─────────────────────────────────────────
/// E-LIBRARY (DIGITAL BOOKS)
/// ─────────────────────────────────────────

model EBook {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bookId         String?  @db.Uuid
  book           Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)

  title          String
  author         String
  description    String?
  coverUrl       String?
  genre          String?
  isbn           String?

  fileKey        String
  fileSize       Int
  fileType       EBookFileType
  isDownloadable Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  readingProgress ReadingProgress[]

  @@index([tenantId])
  @@index([tenantId, genre])
}

model ReadingProgress {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ebookId   String   @db.Uuid
  ebook     EBook    @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid

  currentPage Int    @default(1)
  totalPages  Int?
  expiresAt   DateTime

  updatedAt   DateTime @updatedAt

  @@unique([ebookId, userId])
  @@index([tenantId, userId])
  @@index([expiresAt])
}

enum EBookFileType {
  PDF
  EPUB
}

/// ─────────────────────────────────────────
/// TRANSPORT MANAGEMENT
/// ─────────────────────────────────────────

model Bus {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  busNumber   String
  capacity    Int
  driverName  String
  driverPhone String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routes      BusRoute[]

  @@unique([tenantId, busNumber])
  @@index([tenantId])
}

model BusRoute {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  busId       String   @db.Uuid
  bus         Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  
  routeName   String
  stops       Json     // [{name: "Stop 1", time: "07:00"}, ...]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments BusAssignment[]

  @@index([tenantId, busId])
}

model BusAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  routeId     String    @db.Uuid
  route       BusRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  studentId   String    @db.Uuid
  
  pickupStop  String
  dropStop    String
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([routeId, studentId])
  @@index([tenantId, studentId])
}

/// ─────────────────────────────────────────
/// INVENTORY MANAGEMENT
/// ─────────────────────────────────────────

model Asset {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  category    String   // "Furniture", "Equipment", "Lab Items"
  quantity    Int      @default(1)
  supplier    String?
  purchaseDate DateTime?
  cost        Float?
  location    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions AssetTransaction[]

  @@index([tenantId, category])
}

model AssetTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  assetId     String   @db.Uuid
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  type        AssetTransactionType
  quantity    Int
  remarks     String?
  date        DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, assetId])
}

enum AssetTransactionType {
  PURCHASE
  ALLOCATION
  MAINTENANCE
  DISPOSAL
}

/// ─────────────────────────────────────────
/// EVENT MANAGEMENT
/// ─────────────────────────────────────────

model Notice {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title       String
  content     String
  targetRoles String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt], map: "idx_notice_tenant_created_at")
  @@index([tenantId, authorId], map: "idx_notice_tenant_author")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        String   // "Sports", "Cultural", "Academic"
  venue       String?
  startDate   DateTime
  endDate     DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants EventParticipant[]

  @@index([tenantId, startDate], map: "idx_event_tenant_date")
}

model EventParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  eventId       String   @db.Uuid
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  participantId String   @db.Uuid
  participantType String // "STUDENT", "TEACHER", "STAFF"
  role          String?  // "Participant", "Organizer"
  
  createdAt     DateTime @default(now())

  @@unique([eventId, participantId])
  @@index([tenantId, eventId])
}

/// ─────────────────────────────────────────
/// DISCIPLINARY MANAGEMENT
/// ─────────────────────────────────────────

model DisciplinaryRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId   String   @db.Uuid
  incidentDate DateTime
  description String
  severity    String   // "Minor", "Major", "Severe"
  actionTaken String?
  reportedBy  String?  // teacher/staff ID
  status      String   @default("Open") // "Open", "Resolved", "Under Review"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, studentId])
}

/// ─────────────────────────────────────────
/// HEALTH RECORDS
/// ─────────────────────────────────────────

model HealthRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId   String   @db.Uuid @unique
  bloodGroup  String?
  allergies   String?
  conditions  String?
  emergencyContact Json? // {name, phone, relation}
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incidents   MedicalIncident[]
  vaccinations Vaccination[]

  @@index([tenantId, studentId])
}

model MedicalIncident {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  healthRecordId String    @db.Uuid
  healthRecord HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
  
  date        DateTime     @default(now())
  description String
  treatment   String?
  treatedBy   String?      // nurse/doctor name
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, healthRecordId])
}

model Vaccination {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  healthRecordId String    @db.Uuid
  healthRecord HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
  
  vaccineName String
  date        DateTime
  nextDue     DateTime?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, healthRecordId])
}// Add to end of schema.prisma

/// ─────────────────────────────────────────
/// HOSTEL MANAGEMENT
/// ─────────────────────────────────────────

model HostelRoom {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roomNumber  String
  building    String
  floor       Int
  capacity    Int
  occupied    Int      @default(0)
  type        String   // "Single", "Double", "Dormitory"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments HostelAssignment[]

  @@unique([tenantId, roomNumber, building])
  @@index([tenantId])
}

model HostelAssignment {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  roomId      String     @db.Uuid
  room        HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentId   String     @db.Uuid
  
  startDate   DateTime
  endDate     DateTime?
  bedNumber   String?
  status      String     @default("Active") // "Active", "Inactive"
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, roomId])
}

model MealPlan {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId   String   @db.Uuid
  planType    String   // "Full Board", "Half Board", "Breakfast Only"
  startDate   DateTime
  endDate     DateTime
  specialDiet String?  // "Vegetarian", "Vegan", "Halal", etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, studentId])
}

model VisitorLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId   String   @db.Uuid
  visitorName String
  relation    String
  phone       String?
  checkIn     DateTime @default(now())
  checkOut    DateTime?
  purpose     String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, checkIn])
}

/// ─────────────────────────────────────────
/// SPORTS & EXTRACURRICULAR
/// ─────────────────────────────────────────

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  type        String   // "Sports", "Arts", "Music", "Clubs"
  description String?
  instructor  String?
  schedule    Json?    // {day: "Monday", time: "15:00-17:00"}
  maxCapacity Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments ActivityEnrollment[]
  competitions Competition[]

  @@index([tenantId, type])
}

model ActivityEnrollment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  activityId  String   @db.Uuid
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId   String   @db.Uuid
  
  enrollDate  DateTime @default(now())
  status      String   @default("Active") // "Active", "Inactive"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([activityId, studentId])
  @@index([tenantId, studentId])
}

model Competition {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  activityId  String   @db.Uuid
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  name        String
  date        DateTime
  venue       String?
  participants Json?   // [{studentId, position, score}]
  results     Json?    // {winner, scores}
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, activityId])
  @@index([tenantId, date])
}

/// ─────────────────────────────────────────
/// E-LEARNING SYSTEM
/// ─────────────────────────────────────────

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  thumbnail   String?
  teacherId   String   @db.Uuid
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId   String?  @db.Uuid
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  duration    Int?     // hours
  level       String?  // "Beginner", "Intermediate", "Advanced"
  prerequisites Json?  // [courseId1, courseId2]
  isPublished Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]
  discussions Discussion[]
  certificates Certificate[]

  @@index([tenantId, isPublished])
  @@index([tenantId, teacherId])
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId    String       @db.Uuid
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String
  content     String?      // text content
  type        LessonType
  videoUrl    String?
  duration    Int?         // minutes
  resources   Json?        // [{name, url, type}]
  order       Int
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  progress    LessonProgress[]
  quizzes     Quiz[]

  @@index([tenantId, moduleId, order])
}

enum LessonType {
  VIDEO
  TEXT
  PDF
  QUIZ
  ASSIGNMENT
}

model CourseEnrollment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  courseId    String   @db.Uuid
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId   String   @db.Uuid
  
  enrollDate  DateTime @default(now())
  completedAt DateTime?
  progress    Float    @default(0) // 0-100
  status      EnrollmentStatus @default(ACTIVE)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessonProgress LessonProgress[]

  @@unique([courseId, studentId])
  @@index([tenantId, studentId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model LessonProgress {
  id           String           @id @default(uuid()) @db.Uuid
  enrollmentId String           @db.Uuid
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String           @db.Uuid
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completed    Boolean          @default(false)
  timeSpent    Int              @default(0) // minutes
  lastAccessed DateTime         @default(now())
  
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model Quiz {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId          String?               @db.Uuid
  lesson            Lesson?               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  placement         QuizPlacement         @default(LESSON)
  status            QuizStatus            @default(DRAFT)
  courseId          String?               @db.Uuid
  academicYearId    String?               @db.Uuid
  termId            String?               @db.Uuid
  subjectId         String?               @db.Uuid
  title             String
  description       String?
  durationMinutes   Int?                  // minutes per attempt
  attemptLimit      Int?
  passMark          Float                 @default(70)
  availableFrom     DateTime?
  availableUntil    DateTime?
  gradeSinkType     QuizGradeSinkType     @default(NONE)
  assignmentId      String?               @db.Uuid
  examinationId     String?               @db.Uuid
  resultsVisibility QuizResultsVisibility @default(AFTER_CLOSE)
  questions         Json                  // [{id, prompt, type, options, correctAnswer, points}]
  
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  attempts          QuizAttempt[]

  @@index([tenantId, lessonId])
  @@index([tenantId, courseId])
  @@index([tenantId, subjectId])
  @@index([tenantId, placement, status])
}

model QuizAttempt {
  id                   String   @id @default(uuid()) @db.Uuid
  quizId               String   @db.Uuid
  quiz                 Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  submittedForStudentId String  @db.Uuid
  submittedByUserId    String?  @db.Uuid

  answers              Json     // [{questionId, answer}]
  score                Float
  passed               Boolean
  attemptNumber        Int
  officialScoreApplied Boolean  @default(false)
  startedAt            DateTime @default(now())
  deadlineAt           DateTime?
  completedAt          DateTime?
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([quizId, submittedForStudentId, attemptNumber])
  @@index([quizId, submittedForStudentId])
}

enum QuizPlacement {
  LESSON
  ACADEMIC
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuizGradeSinkType {
  NONE
  ASSIGNMENT
  EXAMINATION
}

enum QuizResultsVisibility {
  AFTER_CLOSE
}

model Submission {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  assignmentId String  @db.Uuid
  studentId   String   @db.Uuid
  
  content     String?
  files       Json?    // [{name, url, size}]
  submittedAt DateTime @default(now())
  grade       Float?
  feedback    String?
  gradedAt    DateTime?
  gradedBy    String?  // teacher ID
  status      SubmissionStatus @default(SUBMITTED)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, assignmentId])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  LATE
}

model LiveClass {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  teacherId   String   @db.Uuid
  subjectId   String?  @db.Uuid
  
  scheduledAt DateTime
  duration    Int      // minutes
  meetingUrl    String?
  meetingId     String?  @db.Uuid
  platform      String   // "JITSI" | "100MS" | "GOOGLE_MEET"
  recordingUrl  String?
  roomName      String?  // generated as {subject-slug}-{YYYY-MM-DD}-{HHmm}
  
  status      LiveClassStatus @default(SCHEDULED)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendance  LiveClassAttendance[]

  @@index([tenantId, scheduledAt])
  @@index([tenantId, teacherId])
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model LiveClassAttendance {
  id          String    @id @default(uuid()) @db.Uuid
  classId     String    @db.Uuid
  class       LiveClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   String    @db.Uuid

  joinedAt    DateTime?
  leftAt      DateTime?
  duration    Int?      // minutes
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([classId, studentId])
  @@index([classId])
}

model Discussion {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId    String   @db.Uuid
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  content     String
  authorId    String   @db.Uuid
  authorType  String   // "STUDENT", "TEACHER"
  isPinned    Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies     DiscussionReply[]

  @@index([tenantId, courseId])
  @@index([tenantId, authorId])
}

model DiscussionReply {
  id           String     @id @default(uuid()) @db.Uuid
  discussionId String     @db.Uuid
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  content      String
  authorId     String     @db.Uuid
  authorType   String     // "STUDENT", "TEACHER"
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([discussionId])
}

model Certificate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId    String   @db.Uuid
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId   String   @db.Uuid

  certificateNumber String @unique
  issuedAt    DateTime @default(now())
  fileUrl     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, studentId])
  @@index([tenantId, studentId])
}

/// ─────────────────────────────────────────
/// BILLING & SUBSCRIPTIONS
/// ─────────────────────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @unique @db.Uuid
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentCount Int
  billingCycle String             // 'per_term' | 'per_session'
  status       SubscriptionStatus @default(TRIAL)
  amount       Int                // in Naira
  paystackRef  String?

  trialEndsAt  DateTime?
  activatedAt  DateTime?
  expiresAt    DateTime?

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tenantId])
}
