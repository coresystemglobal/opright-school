DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
PRISMA_DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&connection_limit=20&pool_timeout=10"

# Upstash Redis (serverless cache)
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-redis-token>"

# Upstash QStash (serverless queues)
QSTASH_TOKEN="<your-qstash-token>"
QSTASH_CURRENT_SIGNING_KEY="sig_<current>"
QSTASH_NEXT_SIGNING_KEY="sig_<next>"
APP_URL="https://your-app-domain.com"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Brevo Email (Transactional)
BREVO_API_KEY="your-brevo-api-key"
BREVO_FROM_EMAIL="no-reply@yourdomain.com"
BREVO_FROM_NAME="School SaaS"

# Backblaze B2 Storage (S3-compatible)
S3_BUCKET="your-bucket-name"
S3_ENDPOINT="https://s3.us-west-000.backblazeb2.com"
S3_ACCESS_KEY_ID="your-backblaze-key-id"
S3_SECRET_ACCESS_KEY="your-backblaze-application-key"
S3_REGION="us-west-000"

# Payment Providers
PAYSTACK_SECRET_KEY="sk_test_..."

# Security
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Note: Generate encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Backblaze B2 Setup:
# 1. Create account at https://www.backblaze.com/b2/cloud-storage.html
# 2. Create a bucket (e.g., "school-saas-files")
# 3. Generate Application Key (Account > App Keys)
# 4. Use keyID as S3_ACCESS_KEY_ID and applicationKey as S3_SECRET_ACCESS_KEY
# 5. Endpoint format: https://s3.{region}.backblazeb2.com

# Server
NODE_ENV="development"
PORT=3000

UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
QSTASH_TOKEN=<token>
QSTASH_CURRENT_SIGNING_KEY=sig_<current>
QSTASH_NEXT_SIGNING_KEY=sig_<next>
APP_URL=https://your-domain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173