# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public base URL of this server (no trailing slash)
# Used in queue worker callback URLs and parent-notification links
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Encryption
# ─────────────────────────────────────────────────────────────────────────────
# Must be a 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/smp?schema=public

# Separate URL used by Prisma migrations / query engine (can be the same as above)
PRISMA_DATABASE_URL=postgresql://user:password@localhost:5432/smp?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis (cache)
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Upstash QStash (background job queue)
# ─────────────────────────────────────────────────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible Object Storage (e.g. AWS S3, Cloudflare R2, MinIO)
# ─────────────────────────────────────────────────────────────────────────────
S3_BUCKET=smp-uploads
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Optional: public CDN/read URL (falls back to S3_ENDPOINT if omitted)
S3_PUBLIC_ENDPOINT=https://cdn.yourdomain.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Email — Brevo (formerly Sendinblue)
# ─────────────────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@yourdomain.com
BREVO_FROM_NAME=SchoolOS

# ─────────────────────────────────────────────────────────────────────────────
# Payments — Paystack
# ─────────────────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare (custom subdomain provisioning)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CNAME_TARGET=websites.schoolos.ng

# ─────────────────────────────────────────────────────────────────────────────
# Web Push (VAPID) — push notifications
# Generate with: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Live Classes — Jitsi (primary, self-hosted)
# JITSI_APP_ID and JITSI_APP_SECRET are set in your Jitsi prosody config
# JITSI_BASE_URL is the public URL of your Jitsi server (no trailing slash)
# ─────────────────────────────────────────────────────────────────────────────
JITSI_APP_ID=smp
JITSI_APP_SECRET=
JITSI_BASE_URL=https://meet.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Live Classes — 100ms (fallback managed provider)
# Get credentials at https://dashboard.100ms.live/developer
# ─────────────────────────────────────────────────────────────────────────────
HUNDREDMS_APP_ACCESS_KEY=
HUNDREDMS_APP_SECRET=
